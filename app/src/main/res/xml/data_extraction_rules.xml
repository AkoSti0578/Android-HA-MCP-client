<?xml version="1.0" encoding="utf-8"?>
<!-- Geen cloud-backup of device-transfer: de Keystore-sleutel reist niet mee, versleutelde data zou onbruikbaar worden. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
